绝对值最大
#include <stdio.h>
#include <stdlib.h>

int main()
{
    int n;
    while(scanf("%d",&n)!= EOF)
    {
        int max_val,temp;
        scanf("%d",&max_val);
        int max_a = abs(max_val);
        for(int i = 1;i < n;i++)
        {
            scanf("%d",&temp);
            if(abs(temp) > max_a)
            {
                max_a = abs(temp);
                max_val = temp;
            }
        }
        printf("%d\n",max_val);
    }
    return 0;
}

字符统计
#include <stdio.h>
#include <stdlib.h>

int main()
{
    char c;
    int a = 0,b = 0,c2 = 0,d = 0;
    while((c = getchar())!= EOF)
    {
        if(c == '\n')
        {
            printf("%d %d %d %d\n",a, b, c2, d);
            a = 0;b = 0;c2 = 0;d = 0;
        }
        else if ((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z'))
            a++;
        else if (c >= '0' && c <= '9')
            b++;
        else if (c == ' ')
            c2++;
        else
            d++;
    }
    return 0;
}

