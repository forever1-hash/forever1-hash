空心三角形
#include <stdio.h>
#include <stdlib.h>

int main()
{
    char ch[100];
    int n[100];
    int count = 0;
    char line[100];

    while(count < 100 && fgets(line, sizeof(line),stdin)!= NULL)
    {
        if(sscanf(line, " %c %d", &ch[count],&n[count]) == 2)
        {
        count++;
        }
    }
    for (int t = 0;t < count; t++)
    {
        if (t > 0)
            printf("\n");
        for(int i = 1;i < n[t];i++)
        {
            for(int j = 0;j < n[t] - i;j++)
                printf(" ");
            printf("%c", ch[t]);
            if(i > 1)
            {
                for(int j = 0;j < 2 * i - 3;j++)
                    printf(" ");
                printf("%c", ch[t]);
            }
            printf("\n");
        }
        for(int i = 0;i < 2 * n[t] - 1;i++)
            printf("%c", ch[t]);
        printf("\n");
    }
    return 0;
}