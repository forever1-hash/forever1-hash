score = float(input("please input the score:"))

if score >= 85 and score <= 100:
    print("优秀")
elif score >= 70 and score <= 84:
    print("良好")
elif score >= 60 and score <= 69:
    print("及格")
else:
    print("不及格")


try:
    year = int(input("输入年份："))
    if (year % 4 == 0 and year % 100 != 0) or (year % 400 == 0):
        print(f"{year}年是闰年")
    else:
        print(f"{year}年不是闰年")
except ValueError:
    print("error")


