第六次
try:
    num1 = int(input("请输入第一个整数："))
    num2 = int(input("请输入第二个整数："))
    
    if num2 == 0:
        print("除数不能为零，无法计算")
    else:
        quotient = num1 / num2
        print(f"{num1}除以{num2}的商为：{quotient}")
except ValueError:
    print("输入无效，请确保输入的是整数")



try:
    x = float(input("请输入购物金额 x:"))
    
    if x < 0:
        print("购物金额不能为负数")
    elif x < 100:
            actual_amount = x
    elif 100 <= x < 300:
            actual_amount = x * 0.9
    elif 300 <= x < 600:
            actual_amount = x * 0.8
    elif x >= 600:
            actual_amount = x * 0.7
    print(f"顾客应付金额为{actual_amount:.2f}元")
except ValueError:
        print("输入无效")

try:    
    n = int(input("请输入三位整数："))
    if 100 <= n <= 999:
        bai = n // 100
        shi = n // 10 % 10
        ge = n % 10
        
        print("百位", bai)
        print("十位", shi)
        print("个位", ge)
    else:
        print("错误，请输入三位整数:100--999")
except Exception as e:
    print("please input number:100--999!")


